#compdef wsctl

_arguments -C \
  '1:command:(save snapshot list show restore archive)' \
  '*::arg:->args'

case $words[2] in
  save)
    _arguments '2:snapshot name:' '--allow-partial[save incomplete placement or Codex data]'
    ;;
  snapshot)
    _arguments '2:target:(browser all)' '3:snapshot name:' \
      '--allow-partial[save incomplete browser, placement, or Codex data]'
    ;;
  list)
    _arguments '--all[include archived snapshots]' '--json[print JSON]'
    ;;
  show)
    _arguments '2:snapshot name:->snapshots' '--json[print JSON]' '--details[list tmux names]'
    ;;
  restore)
    _arguments '2:target or snapshot:->restore_target' '3:snapshot name:->snapshots' \
      '--workspace=[restore named workspace]:workspace:(Life Work PhD Students Other Gaming)' \
      '*--session=[restore tmux session]:session:' \
      '--select[select sessions with fzf]' '--dry-run[print actions only]' \
      '--no-place[skip GNOME window placement for all windows]'
    ;;
  archive)
    _arguments '2:snapshot name:->snapshots' '--undo[unarchive snapshot]'
    ;;
esac

if [[ $state == restore_target ]]; then
  local -a restore_choices snapshots
  snapshots=(${${(f)"$(wsctl list --all 2>/dev/null)"}%% *})
  restore_choices=(browser all terminals $snapshots)
  _describe 'target or snapshot' restore_choices
fi

if [[ $state == snapshots ]]; then
  local -a snapshots
  snapshots=(${${(f)"$(wsctl list --all 2>/dev/null)"}%% *})
  _describe 'snapshot' snapshots
fi
