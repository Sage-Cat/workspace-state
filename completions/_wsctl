#compdef wsctl

_arguments -C \
  '1:command:(save show restore startup tmux alerts deployment workspace browser)' \
  '*::arg:->args'

case $words[2] in
  workspace)
    _arguments '2:action:(list off on forget)' '--json[print workspace states]' \
      '--yes[confirm discarding the switch archive]' '3:workspace name:'
    ;;
  browser)
    _arguments '2:action:(reopen)' '--profile=[only this Chrome profile]:profile:' \
      '*--window=[only this saved window]:window:' '--dry-run[print actions only]'
    ;;
  deployment)
    _arguments '2:action:(stage schedule deploy install rollback doctor fingerprint dev-link migrate-inventory)' \
      '--manifest=[release manifest]:manifest:_files' \
      '--source-root=[sibling repositories]:directory:_files -/' \
      '--host-integration[include maintained host integration]'
    ;;
  alerts)
    _arguments '2:action:(scan list sources report resolve ack)' \
      '--json[print scan JSON]' '--history[include resolved acknowledged history]' \
      '--lookback-hours=[recheck retained own-unit journals]:hours:'
    ;;
  save)
    _arguments '--allow-partial[save incomplete companion, placement, or Codex data]' \
      '--verify-idle-codex[verify unresolved conversation IDs in idle empty composers]'
    ;;
  show)
    _arguments '--json[print JSON]' '--details[list tmux and browser names]'
    ;;
  restore)
    _arguments '2:category:(terminals browsers social-apps file-manager vscode)' \
      '--workspace=[restore named workspace]:workspace:(Life Work PhD Students Other Gaming)' \
      '*--session=[restore tmux session]:session:' \
      '--select[select sessions with fzf]' '--dry-run[print actions only]' \
      '--from-history=[read a verified checkpoint generation]:generation:_files' \
      '--terminal-placement-only[place one attached terminal without changing tmux]' \
      '--maximize[maximize the selected editor on its saved monitor]' \
      '--deck-dashboard[restore a scoped Agent Deck dashboard]:profile: :group:' \
      '--deck-window=[name the restored dashboard window]:window:' \
      '--deck-placeholder=[select the dashboard when the named placeholder is idle]:window:' \
      '--no-place[skip GNOME window placement]'
    ;;
  startup)
    _arguments '2:category:(terminals browsers social-apps file-manager vscode)' \
      '--dry-run[print actions only]' '--no-place[skip GNOME window placement]' \
      '--force[run again during this login]' '--wait=[GNOME readiness timeout]:seconds:'
    ;;
  tmux)
    _arguments '2:hook:(save configure unconfigure)'
    ;;
esac
