{
  "manifest_version": 3,
  "name": "Workspace State Companion",
  "version": "0.5.1",
  "description": "Captures and restores Chrome windows for wsctl.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "identity",
    "identity.email",
    "storage",
    "tabs",
    "tabGroups"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "options_page": "options.html"
}
