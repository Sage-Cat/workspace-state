#!/bin/sh

# While this login's terminal restore has not finished (wsctl has not written
# terminals.done), a user terminal must never create or attach `main`: the
# user's shell would create an empty `main` before wsctl restores the saved
# one. It gets a temporary workspace-scoped tmux session like every later
# launch, and an unclear state counts as unfinished. A temporary session never
# takes the name of a saved tmux session, on any launch, so restore can always
# recreate it; if the saved names cannot be read, the name gets a per-launch
# suffix (this wrapper's PID). Every tmux target names the session exactly
# (`=`): a closed `Workspace-1` must never resolve to a restored `Workspace-10`.
unset WINIT_UNIX_BACKEND
script_path=$(readlink -f -- "$0")
bin_dir=$(CDPATH= cd -- "$(dirname -- "${script_path}")" && pwd)
repo_dir=$(CDPATH= cd -- "${bin_dir}/.." && pwd)

restore_pending() {
  startup_dir=$(PYTHONPATH="${repo_dir}/src${PYTHONPATH:+:${PYTHONPATH}}" \
    python3 -m workspace_state.startup directory 2>/dev/null) || return 0
  [ -n "${startup_dir}" ] || return 0
  [ ! -f "${startup_dir}/terminals.done" ]
}

"${bin_dir}/wsctl-startup-launch" >/dev/null 2>&1
startup_status=$?
# 0: this launch claimed the login; 2: a concurrent launch did. Once the
# terminal restore has finished, `main` is the user's again.
case "${startup_status}" in
  0|2) restore_pending || exec /usr/bin/alacritty ;;
esac

saved_sessions_rc=0
saved_sessions=$(PYTHONPATH="${repo_dir}/src${PYTHONPATH:+:${PYTHONPATH}}" \
  /usr/bin/timeout 5 python3 -m workspace_state.startup saved-sessions 2>/dev/null) ||
  saved_sessions_rc=1

session_name=""

cleanup_session() {
  if [ -n "${session_name}" ]; then
    attached=$(/usr/bin/tmux display-message -p -t "=${session_name}:" \
      '#{session_attached}' 2>/dev/null || true)
    if [ "${attached}" = "0" ]; then
      /usr/bin/tmux kill-session -t "=${session_name}" 2>/dev/null || true
    fi
  fi
}

trap cleanup_session EXIT

current_workspace() {
  winctl=$(command -v gnome-winctl 2>/dev/null || true)
  [ -n "${winctl}" ] || return 0
  "${winctl}" state --json 2>/dev/null |
    /usr/bin/python3 -c '
import json
import sys

try:
    state = json.load(sys.stdin)
    index = int(state["active_workspace"])
    workspace = next(item for item in state["workspaces"] if int(item["index"]) == index)
    print(workspace["name"])
except Exception:
    pass
'
}

workspace_name=$(current_workspace)
workspace_slug=$(printf '%s' "${workspace_name}" |
  LC_ALL=C /usr/bin/tr -cs 'A-Za-z0-9_-' '-' |
  /usr/bin/sed 's/^-*//; s/-*$//')
[ -n "${workspace_slug}" ] || workspace_slug="Workspace"

highest_number=$(/usr/bin/tmux list-sessions -F '#S' 2>/dev/null |
  /usr/bin/sed -n "s/^${workspace_slug}-\\([0-9][0-9]*\\)$/\\1/p" |
  /usr/bin/sort -n |
  /usr/bin/tail -n 1)
case "${highest_number}" in
  ''|*[!0-9]*) session_number=1 ;;
  *) session_number=$((highest_number + 1)) ;;
esac

while :; do
  if [ "${saved_sessions_rc}" -eq 0 ]; then
    candidate_name="${workspace_slug}-${session_number}"
    if printf '%s\n' "${saved_sessions}" | /usr/bin/grep -Fqx -- "${candidate_name}"; then
      session_number=$((session_number + 1))
      continue
    fi
  else
    candidate_name="${workspace_slug}-${session_number}-$$"
  fi
  if /usr/bin/tmux new-session -d -s "${candidate_name}" -c "${HOME}" 2>/dev/null; then
    session_name="${candidate_name}"
    break
  fi
  session_number=$((session_number + 1))
done

# Let tmux own the lifetime once the first terminal client attaches.  An
# Alacritty window may be closed by the compositor together with this wrapper,
# in which case the EXIT trap below never gets a chance to run.  Enabling the
# option from client-attached avoids destroying the deliberately detached
# session in the short interval before Alacritty connects to it.
/usr/bin/tmux set-hook -t "=${session_name}:" client-attached \
  "set-option -t =${session_name}: destroy-unattached on"

/usr/bin/alacritty \
  --title "${session_name}" \
  --option 'window.dynamic_title=false' \
  -e /usr/bin/tmux attach-session -t "=${session_name}"
exit_status=$?
exit "${exit_status}"
