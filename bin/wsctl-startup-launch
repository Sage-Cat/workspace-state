#!/bin/sh
set -eu

# Claim the first terminal launch of this login and ask the user manager to
# own one delayed recovery worker.  Keeping the worker in a transient service
# prevents restored applications from becoming descendants of the GNOME
# session coordinator.
runtime_root=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/workspace-state
boot_id=$(sed -n '1p' /proc/sys/kernel/random/boot_id 2>/dev/null || true)
[ -n "${boot_id}" ] || boot_id=current-boot
login_generation=$(sed -n '1p' "${runtime_root}/login-generation" 2>/dev/null || true)
case "${login_generation}" in
  ''|*[!0-9a-f]*) login_generation= ;;
esac
script_path=$(readlink -f -- "$0")
bin_dir=$(CDPATH= cd -- "$(dirname -- "${script_path}")" && pwd)
repo_dir=$(CDPATH= cd -- "${bin_dir}/.." && pwd)
export PYTHONPATH="${repo_dir}/src${PYTHONPATH:+:${PYTHONPATH}}"
# One implementation owns generation adoption for shell and Python callers.
if startup_dir=$(python3 -m workspace_state.startup directory); then
  :
else
  result=$?
  [ "$result" -eq 4 ] && exit 1
  exit "$result"
fi
if operation_context=$(python3 -m workspace_state.startup context 2>/dev/null); then
  export WSCTL_OPERATION_CONTEXT=$operation_context
fi
terminal_marker=${startup_dir}/terminals.done
browser_marker=${startup_dir}/browsers.done
vm_marker=${startup_dir}/virtual-machines.done
social_marker=${startup_dir}/social-apps.done
launcher_marker=${startup_dir}/launcher.claimed
lock_file=${startup_dir}/launcher.lock
log_file=${startup_dir}/startup.log
script_path=$(readlink -f -- "$0")
bin_dir=$(CDPATH= cd -- "$(dirname -- "${script_path}")" && pwd)
wsctl_command=${bin_dir}/wsctl
worker_command=${bin_dir}/wsctl-startup-worker
systemd_run=${WSCTL_SYSTEMD_RUN:-/usr/bin/systemd-run}

umask 077
mkdir -p -- "${startup_dir}"
chmod 700 -- "${runtime_root}" "${startup_dir}"
exec 9>"${lock_file}"
/usr/bin/flock -n 9 || exit 2

# Startup is a one-shot launch decision, not a statement that every restore
# category succeeded. In particular, a failed browser restore must not make
# every later Ctrl+Alt+T invocation rejoin the bootstrap `main` session.
if [ -f "${launcher_marker}" ]; then
  exit 1
fi
: >"${launcher_marker}"
chmod 600 -- "${launcher_marker}"

# Existing runtime directories from before launcher.claimed was introduced may
# already contain evidence of an attempted startup. Migrate them without
# starting a second recovery worker during the same login.
if [ -f "${terminal_marker}" ] || [ -f "${browser_marker}" ] || \
   [ -f "${vm_marker}" ] || [ -f "${social_marker}" ] || [ -f "${log_file}" ]; then
  exit 1
fi

if [ ! -x "${worker_command}" ] || [ ! -x "${wsctl_command}" ] || [ ! -x "${systemd_run}" ]; then
  printf '%s\n' "wsctl: startup worker is not installed" >&2
  exit 3
fi

unit_key=${login_generation:-${boot_id}}
worker_unit=wsctl-startup-restore-${unit_key}.service
worker_budget=7min
if [ -n "${WSCTL_OPERATION_CONTEXT:-}" ]; then
  worker_budget=$(python3 -m workspace_state.startup worker-budget) || exit 3
fi
"${systemd_run}" --user --quiet --collect \
  --service-type=exec \
  --unit="${worker_unit}" \
  --property=TimeoutStartSec=30s \
  --property="RuntimeMaxSec=${worker_budget}" \
  --setenv="PYTHONPATH=${PYTHONPATH}" \
  --setenv="WSCTL_OPERATION_CONTEXT=${WSCTL_OPERATION_CONTEXT:-}" \
  --property="ExecStopPost=\"${worker_command}\" --service-result" \
  --property=TimeoutStopSec=10s \
  --property=PartOf=graphical-session.target \
  --property=After=graphical-session.target \
  --property=KillMode=control-group \
  -- "${worker_command}" "${log_file}"
