#!/bin/sh

# Launch natively on Wayland. While this login's terminal restore can still
# run and has not finished, a terminal without arguments must not run the
# user's shell, which would create `main` before wsctl: it gets a temporary
# workspace-scoped tmux session instead. Otherwise, or with explicit
# arguments, this process becomes a plain Alacritty. The wrapper starts no
# restore; only the session agent does.
unset WINIT_UNIX_BACKEND
script_path=$(readlink -f -- "$0")
bin_dir=$(CDPATH= cd -- "$(dirname -- "${script_path}")" && pwd)
repo_dir=$(CDPATH= cd -- "${bin_dir}/.." && pwd)

# Exit status 0 alone means settled. Pending, a crash, a timeout or a missing
# python all count as unfinished: a false "pending" costs only a temporary
# session, a false "settled" lets the user's shell create `main` too early.
restore_settled() {
  PYTHONPATH="${repo_dir}/src${PYTHONPATH:+:${PYTHONPATH}}" \
    /usr/bin/timeout 8 python3 -m workspace_state.startup terminals-settled >/dev/null 2>&1
}

if [ "$#" -eq 0 ] && ! restore_settled; then
  exec "${bin_dir}/alacritty-tmux-session"
fi
exec /usr/bin/alacritty "$@"
