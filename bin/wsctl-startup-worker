#!/bin/sh
# Retired shim: the restore runs as `wsctl startup` in a transient service. Only the failure report of a unit an older release started still works; every other call exits 1.
if [ "${1:-}" = "--service-result" ]; then
  script_path=$(readlink -f -- "$0")
  exec "$(dirname -- "${script_path}")/wsctl-python" workspace_state.startup worker-exit
fi
exit 1
