#!/bin/sh
set -eu

# tmux-resurrect names state files with one-second precision. Serialize the
# complete save (continuum's own lock is released after it forks save.sh) and
# keep each candidate distinct from the current `last` target, which otherwise
# could be deleted as an "unchanged" candidate.
umask 077
shutdown_operation=
if [ "${1:-}" = "--shutdown-operation" ]; then
  shutdown_operation=${2:-}
  case "${shutdown_operation}" in
    ''|*[!0-9a-f]*)
      echo "wsctl: invalid shutdown operation ID" >&2
      exit 2
      ;;
  esac
  [ "${#shutdown_operation}" -eq 32 ] || {
    echo "wsctl: invalid shutdown operation ID" >&2
    exit 2
  }
  shift 2
  export WSCTL_SHUTDOWN_OPERATION_ID=${shutdown_operation}
fi

# A cancelled application drain deliberately leaves its pre-close checkpoint
# intact. Check before mutation and again after waiting for the save lock.
wsctl_bin=$(dirname -- "$0")/wsctl
save_allowed() {
  if [ -n "${shutdown_operation}" ]; then
    set -- --shutdown-operation "${shutdown_operation}"
  else
    set --
  fi
  if "${wsctl_bin}" tmux save-allowed "$@"; then
    return 0
  else
    guard_status=$?
    if [ "${guard_status}" -eq 1 ]; then
      echo "wsctl: terminal autosave deferred; verified pre-drain checkpoint retained" >&2
      exit 0
    fi
    echo "wsctl: cannot verify terminal checkpoint protection" >&2
    exit "${guard_status}"
  fi
}
save_allowed

plugin_root=${TMUX_PLUGIN_MANAGER_PATH:-${HOME}/.tmux/plugins}
save_script=${plugin_root%/}/tmux-resurrect/scripts/save.sh

[ -x "${save_script}" ] || {
  echo "wsctl: tmux-resurrect save script is unavailable: ${save_script}" >&2
  exit 2
}
command -v flock >/dev/null 2>&1 || {
  echo "wsctl: flock is required to serialize tmux-resurrect saves" >&2
  exit 2
}

runtime_root=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
[ -d "${runtime_root}" ] || {
  echo "wsctl: runtime directory is unavailable: ${runtime_root}" >&2
  exit 2
}
lock_root=${runtime_root%/}/workspace-state
[ ! -L "${lock_root}" ] || {
  echo "wsctl: runtime lock directory must not be a symbolic link: ${lock_root}" >&2
  exit 2
}
mkdir -p -- "${lock_root}"
[ -d "${lock_root}" ] && [ ! -L "${lock_root}" ] || exit 2
chmod 700 -- "${lock_root}"
stamp_file=${lock_root}/tmux-resurrect-save.second
[ ! -L "${stamp_file}" ] || {
  echo "wsctl: tmux save stamp must not be a symbolic link: ${stamp_file}" >&2
  exit 2
}

exec 9<"${lock_root}"
if [ -n "${shutdown_operation}" ]; then
  flock -w 10 9 || {
    echo "wsctl: timed out waiting for the shutdown tmux save lock" >&2
    exit 2
  }
else
  flock -n 9 || exit 0
fi
save_allowed

current_second=$(date +%s)
saved_second=
if [ -f "${stamp_file}" ]; then
  IFS= read -r saved_second < "${stamp_file}" || saved_second=
fi
rollover_attempt=0
# The runtime stamp can be absent after a reset, or a save can have bypassed
# this wrapper. A required shutdown save waits past the observed second so its
# filename cannot overwrite any existing `last` target from that second.
collision_second=${saved_second}
[ -z "${shutdown_operation}" ] || collision_second=${current_second}
while [ "${collision_second}" = "${current_second}" ]; do
  [ -n "${shutdown_operation}" ] || exit 0
  [ "${rollover_attempt}" -lt 20 ] || {
    echo "wsctl: timed out waiting for a distinct shutdown tmux checkpoint second" >&2
    exit 2
  }
  sleep 0.1
  rollover_attempt=$((rollover_attempt + 1))
  current_second=$(date +%s)
done

if [ -n "${shutdown_operation}" ]; then
  save_allowed
  tmux set-environment -g WSCTL_SHUTDOWN_OPERATION_ID "${shutdown_operation}"
  cleanup_shutdown_environment() {
    tmux set-environment -gu WSCTL_SHUTDOWN_OPERATION_ID 2>/dev/null || true
  }
  trap cleanup_shutdown_environment EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
fi

"${save_script}" "$@"
completed_second=$(date +%s)
printf '%s\n' "${completed_second}" > "${stamp_file}"
