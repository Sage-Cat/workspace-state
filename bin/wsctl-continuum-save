#!/bin/sh
# Compatibility shim for tmux configurations that still point
# @resurrect-save-script-path or a key binding here. It runs only the terminal
# checkpoint of wsctl, never tmux-resurrect, and never reports a failure to the
# calling plugin.
script_path=$(readlink -f -- "$0")
"$(dirname -- "${script_path}")/wsctl" tmux save >/dev/null 2>&1 || true
exit 0
